rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(r) { return signedIn() && userDoc().data.role == r; }
    function isAdmin() { return role('admin'); }
    function isActive() { return signedIn() && userDoc().data.active != false; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'client';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A user may edit their profile, but cannot change role/active status.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    match /tariffs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn() && isActive()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'new';

      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid
        || isAdmin()
        || resource.data.courierId == request.auth.uid
        || role('dispatcher')
        || role('restaurant')
      );

      // Admin can manage an order. Other roles can only make operational
      // changes appropriate to their role; clients cannot alter financial
      // fields, assignment, restaurant, or order status.
      allow update: if isAdmin()
        || (role('dispatcher') && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['courierId','courierName','status','updatedAt']))
        || (role('courier') && resource.data.courierId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','updatedAt']))
        || (role('restaurant')
            && request.resource.data.restaurantId == resource.data.restaurantId
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','updatedAt']))
        || (signedIn() && resource.data.clientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['comment','phone','address','updatedAt']));

      allow delete: if isAdmin();
    }

    match /restaurants/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin()
        || (role('restaurant') && resource.data.ownerId == request.auth.uid);
      match /menu/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin()
          || (role('restaurant') && get(/databases/$(database)/documents/restaurants/$(id)).data.ownerId == request.auth.uid);
      }
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
